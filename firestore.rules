rules_version = '2';
// Gavel database rules. Paste all of this into Firebase → Firestore Database → Rules → Publish.
// Everyone can read and write only their own profile and sessions.
// Plan fields are written only by the billing worker (with a service account, which skips these rules).
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }
    function billingKeys() { return ['plan', 'plan_until', 'plan_kind', 'billing']; }
    // the free trial can be started once, stamped with the server's own clock
    function trialOk(before) {
      let after = request.resource.data.get('trial_started', null);
      return after == before || (before == null && after == request.time);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && !request.resource.data.keys().hasAny(billingKeys())
        && trialOk(null);
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(billingKeys())
        && trialOk(resource.data.get('trial_started', null));
      allow delete: if false;

      match /sessions/{sid} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['data', 'deleted', 'updated_at'])
          && request.resource.data.data is string
          && request.resource.data.data.size() < 900000
          && request.resource.data.deleted is bool;
      }
    }

    match /{document=**} { allow read, write: if false; }
  }
}
